# ==============================================================================
# RepoDoctor Environment Configuration
# Copy this file to .env and configure your keys:
#   cp .env.example .env
# ==============================================================================

# LLM Provider to use: "gemini", "anthropic", or "mock"
# - "gemini": Uses Google Gemini models (requires GEMINI_API_KEY).
# - "anthropic": Uses Anthropic Claude models (requires ANTHROPIC_API_KEY).
# - "mock": Replays canned diagnostic fixes for testing without LLM API calls.
LLM_PROVIDER=

# Google Gemini API Key
# Obtain a free API key at: https://aistudio.google.com
# Required when LLM_PROVIDER is "gemini" (or left blank).
GEMINI_API_KEY=

# Anthropic Claude API Key
# Obtain an API key at: https://console.anthropic.com
# Required when LLM_PROVIDER is "anthropic".
ANTHROPIC_API_KEY=

# Model Name (Optional)
# If left blank for Gemini, RepoDoctor auto-detects the latest available Flash model.
# For Anthropic, set to e.g. claude-3-5-sonnet-20241022.
MODEL_NAME=

# GitHub Personal Access Token
# A fine-grained GitHub token with "Contents" (Read & Write) and "Pull requests"
# (Read & Write) permissions on ONLY the target repository you want RepoDoctor to fix.
# Generate one at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
